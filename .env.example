# Runtime mode: mock keeps the app local and generates synthetic OI/quote events.
# Runtime mode: eod uses daily snapshots for dashboard analysis.
KQUANT_MODE=eod

# Optional: point this at a daily KRX/KIS export converted to the schema in db/eod_snapshot.example.json.
KQUANT_EOD_SNAPSHOT=db/eod_snapshot.json

# Fill these when attaching a real broker collector.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=
KIS_API_BASE=https://openapi.koreainvestment.com:9443
KIS_WS_BASE=ws://ops.koreainvestment.com:21000

# Logging: keep access logs off if you do not want every page/API hit written.
KQUANT_ACCESS_LOG=false
